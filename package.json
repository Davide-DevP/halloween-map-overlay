{
  "name": "halloween-map-overlay",
  "version": "1.1.1",
  "description": "Transparent in-game map overlay for Halloween: The Game",
  "author": "Halloween Map Overlay contributors",
  "main": "index.js",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "prepare-maps": "node scripts/prepare-maps.js",
    "prepare-detector": "node scripts/prepare-detector.js",
    "build-markers": "node scripts/build-markers.js",
    "probe-pad": "node scripts/probe-pad.js",
    "build-pack": "node scripts/build-pack.js",
    "build-updater": "node scripts/build-updater.js",
    "build:win": "npm run build-updater && electron-builder -w",
    "build": "npm run build-updater && electron-builder -w"
  },
  "keywords": [
    "halloween-the-game",
    "overlay",
    "map",
    "electron"
  ],
  "build": {
    "productName": "Halloween Map Overlay",
    "appId": "com.halloweenthegame.mapoverlay",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "maps",
        "to": "maps"
      },
      {
        "from": "build/updater",
        "to": "updater"
      }
    ],
    "files": [
      "!maps-src/**",
      "!maps/**",
      "!packs/**",
      "!docs/**",
      "!dist/**",
      "!scripts/**",
      "!test/**",
      "!detection-fixtures/**",
      "!updater/**",
      "!.git/**",
      "!.idea/**",
      "!.github/**",
      "!.vscode/**",
      "!.claude/**",
      "!AGENTS.md",
      "!README.md",
      "!package-lock.json",
      "!**/*.map",
      "!node_modules/**/{README,readme,CHANGELOG,changelog,HISTORY,History}*",
      "!node_modules/bootstrap/{scss,js}/**",
      "!node_modules/bootstrap/dist/css/bootstrap-{grid,reboot,utilities}*",
      "!node_modules/bootstrap/dist/css/*.rtl.*",
      "!node_modules/bootstrap/dist/css/bootstrap.css",
      "!node_modules/bootstrap/dist/js/bootstrap.{bundle,esm}*",
      "!node_modules/bootstrap/dist/js/bootstrap.min.js",
      "!node_modules/jquery/{src,dist-module}/**",
      "!node_modules/jquery/dist/jquery.{min,slim,slim.min,factory,factory.slim}*.js",
      "!node_modules/jquery/dist/wrappers/**",
      "!node_modules/@popperjs/core/{lib,dist/esm,dist/umd}/**",
      "!node_modules/**/*.{d.ts,flow}"
    ],
    "asarUnpack": [
      "node_modules/node-screenshots/**/*.node",
      "node_modules/node-screenshots-*/**/*.node",
      "node_modules/koffi/**/*.node",
      "node_modules/@koromix/**/*.node"
    ],
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "include": "build/installer.nsh",
      "installerLanguages": [
        "en_US",
        "it_IT"
      ],
      "installerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Davide-DevP",
      "repo": "halloween-map-overlay",
      "releaseType": "release"
    },
    "electronLanguages": [
      "en-US",
      "it",
      "es",
      "es-419",
      "de",
      "fr",
      "pt-BR",
      "pt-PT"
    ]
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^26.15.0",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "electron-updater": "^6.7.3",
    "image-size": "^2.0.2",
    "jquery": "^4.0.0",
    "koffi": "^3.3.1",
    "node-screenshots": "^0.2.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Davide-DevP/halloween-map-overlay.git"
  }
}
